# .env dla serwera VPS (2.petracker.pl za nginx). Skopiuj jako /var/www/2.petracker.pl/.env
# i uzupełnij miejsca oznaczone <…> (docs/DEPLOY.md, krok 3).

# Publiczny adres – z niego powstają linki w mailach, na tagach, plakatach i kodach QR.
DOCKER_APP_URL=https://2.petracker.pl

# Kontener słucha TYLKO lokalnie; z internetu ruch przychodzi przez nginx.
# Uwaga: bez „127.0.0.1:” Docker wystawiłby port na świat z pominięciem zapory ufw.
HTTP_PORT=127.0.0.1:8090
DB_PORT=5442

# Hasło do bazy (tylko litery i cyfry): openssl rand -hex 24
POSTGRES_PASSWORD=<wklej>

# Sekret do kodów logowania (min. 32 znaki): openssl rand -hex 32
AUTH_SECRET=<wklej>

# Za nginx: ciasteczko tylko przez HTTPS i jeden pośrednik przed aplikacją.
COOKIE_SECURE=true
TRUST_PROXY=1

# Do pokazu: konto demo (Burek, Luna, Fistaszek) i przycisk „Wejdź na konto demo”.
# Gdy aplikacja ma służyć prawdziwym użytkownikom – ustaw oba na false.
SEED_DEMO=true
DEMO_LOGIN=true

REVERSE_GEOCODING=true

# Poczta. Możesz skopiować dane SMTP z ~/prototyp/.env (wersja klasyczna).
# Puste SMTP_HOST = kod i link logowania tylko w logach: docker compose logs app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PeTrace <no-reply@petracker.pl>
