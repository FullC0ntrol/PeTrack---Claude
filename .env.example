# Skopiuj do .env (cp .env.example .env). Plik .env nie trafia do repozytorium.
# Z .env korzysta zarówno `npm run dev` (serwer czyta go sam), jak i `docker compose up`.

# Publiczny adres aplikacji – z niego powstają linki w mailach, na tagach i plakatach.
# Dev (Vite): http://localhost:5173   Docker: http://localhost:8090
APP_URL=http://localhost:5173

# Adres aplikacji w Dockerze (docker compose up). Osobna zmienna, żeby jeden .env
# obsługiwał oba tryby. Port na komputerze: HTTP_PORT.
DOCKER_APP_URL=http://localhost:8090
HTTP_PORT=8090

# Port serwera Express (w Dockerze wewnątrz kontenera zawsze 3000).
PORT=3000

# Baza danych. Dev: Postgres z `docker compose up -d db` wystawiony na localhost:5442.
DATABASE_URL=postgres://petrace:petrace@localhost:5442/petrace
POSTGRES_PASSWORD=petrace

# Sekret do HMAC kodów logowania. Długi i losowy: openssl rand -hex 32
AUTH_SECRET=zmien-mnie-na-dlugi-losowy-sekret-w-produkcji

# true = przy starcie wczytaj konto demo (demo@petrace.app), jeśli jeszcze go nie ma.
SEED_DEMO=true

# true = przycisk „Wejdź na konto demo” na stronie logowania. Na publicznym serwerze: false.
DEMO_LOGIN=true

# Ciasteczko sesji tylko przez HTTPS. Na serwerze z HTTPS: true.
COOKIE_SECURE=false

# Liczba proxy przed aplikacją (np. 1 za nginx/Caddy). 0 = aplikacja wystawiona bezpośrednio.
TRUST_PROXY=0

# Nazwy ulic w dzienniku skanów (OpenStreetMap Nominatim). false = same współrzędne.
REVERSE_GEOCODING=true

# Poczta (SMTP). Puste SMTP_HOST = link i kod logowania lądują w konsoli serwera.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PeTrace <no-reply@petrace.app>
