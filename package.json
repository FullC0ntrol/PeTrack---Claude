{
  "name": "petrace-alt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PeTrace Alt – identyfikacja zwierząt przez tagi NFC/QR (inny wygląd i UX).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch-path=server server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint .",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js --reset",
    "tags:generate": "node server/scripts/generate-tags.js",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
